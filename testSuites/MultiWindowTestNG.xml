<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite  name="All Test Suite" parallel="methods" thread-count="2">
    <groups>
        <run>
            <include name="MultiWindow"/>
        </run>
    </groups>
    <listeners>
        <listener class-name="org.practice.utilsForTests.Listeners" />
    </listeners>
    <test verbose="2" preserve-order="true" name="MultiWindow Test">
        <classes>
            <class name="org.practice.tests.PracticeTest">  </class>
        </classes>
    </test>
</suite>